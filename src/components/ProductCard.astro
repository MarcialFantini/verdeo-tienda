---
import { ROOMS, type Product } from '../data/catalog';
import { formatPrice } from '../lib/format';
import Furniture from './Furniture.astro';
import Icon from './Icon.astro';

interface Props {
  product: Product;
  eager?: boolean;
}
const { product } = Astro.props;
---
<article
  class="card"
  data-card
  data-id={product.id}
  data-room={product.room}
  data-woods={product.woods.join(' ')}
  data-fabric={product.fabrics.length ? 'si' : 'no'}
  data-price={product.basePrice}
  data-days={product.days}
  data-pop={product.popularity.toFixed(3)}
  data-new={product.isNew ? '1' : '0'}
  data-order={product.order}
  data-name={product.name}
>
  <a class="card-link" href={`/producto/${product.slug}`}>
    <div class="card-stage">
      <Furniture product={product} vt pad={14} />
      <span class="stock-flag" data-stock-for={product.id} hidden></span>
    </div>
    <h3 class="card-name">{product.name}</h3>
    <p class="card-meta">
      <span>{ROOMS[product.room]} · {product.days} días</span>
      <span class="card-price num">desde {formatPrice(product.basePrice)}</span>
    </p>
  </a>
  <button class="wish-btn" type="button" data-wish={product.id} aria-pressed="false" aria-label={`Guardar ${product.name} en favoritos`}>
    <Icon name="heart" size={20} />
  </button>
</article>
