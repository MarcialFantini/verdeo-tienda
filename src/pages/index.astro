---
import Layout from '../layouts/Layout.astro';
import Furniture from '../components/Furniture.astro';
import Configurator from '../components/Configurator.astro';
import RoomScene from '../components/RoomScene.astro';
import ProductionSlip from '../components/ProductionSlip.astro';
import BoxScene from '../components/BoxScene.astro';
import ShippingMap from '../components/ShippingMap.astro';
import Icon from '../components/Icon.astro';
import { PRODUCTS, KINDS } from '../data/catalog';
import { formatPrice } from '../lib/format';

const chair = PRODUCTS[0]!;
const sofa = PRODUCTS[1]!;

// The workshop's printed list: twelve lines, five pieces each.
const lines = [...new Set(PRODUCTS.map((p) => p.line))].map((line) => {
  const items = PRODUCTS.filter((p) => p.line === line);
  return { line, items };
});
const seatingLines = lines.filter((_, i) => i % 2 === 0).slice(0, 2);
const storageLines = lines.filter((_, i) => i % 2 === 1).slice(0, 2);
---
<Layout title="Inicio" view="home">
  <div class="split" data-hero>
    <div class="split-read">
      <section class="hero-copy" aria-labelledby="hero-title">
        <h1 id="hero-title">Hecho mientras lo elegís</h1>
        <p class="hero-sub">Sillas, mesas y camas de madera maciza que se fabrican en Tucumán en quince días, en la madera, la tela y la medida que elijas.</p>
        <div class="hero-actions">
          <a class="btn" href="#configurador">Armar mi silla <Icon name="arrow" size={20} /></a>
          <a class="link-btn" href="/catalogo">Ver los 60 muebles</a>
        </div>
        <dl class="hero-facts">
          <div><dt>Desde</dt><dd class="serif num">{formatPrice(chair.basePrice)}</dd></div>
          <div><dt>Fabricación</dt><dd class="serif num">{chair.days} días</dd></div>
          <div><dt>Envío</dt><dd class="serif">a todo el país</dd></div>
        </dl>
      </section>

      <section class="cfg-block" id="configurador" aria-labelledby="cfg-title">
        <h2 id="cfg-title">Elegí la madera y mirala cambiar</h2>
        <p class="lede">Cuatro maderas del norte, cinco telas y tres medidas. El precio se recalcula al instante.</p>
        <Configurator product={chair} stage="#home-stage" compact id="home" />
        <a class="link-btn" href={`/producto/${chair.slug}`}>Ver la ficha completa de la {chair.name}</a>
      </section>
    </div>

    <div class="split-stage">
      <div class="stage-panel" id="home-stage" data-wood={chair.defaultWood} data-fabric={chair.defaultFabric ?? ''} data-assembly>
        <Furniture product={chair} explode pad={6} label={`${chair.name}: sus piezas se encastran a medida que bajás`} />
        <div class="stage-bar">
          <span><strong data-pieces class="num">0 de 6</strong> piezas encastradas</span>
          <span>{chair.name} · taller de Yerba Buena</span>
        </div>
      </div>
    </div>
  </div>

  <section class="home-room wrap" aria-labelledby="room-h">
    <div class="section-head">
      <h2 id="room-h">Probalo en tu living</h2>
      <p class="lede">Arrastrá el {sofa.name.toLowerCase()} por una habitación de cuatro metros. La regla marca su lugar exacto, en centímetros.</p>
    </div>
    <RoomScene product={sofa} id="home-room" />
  </section>

  <section class="home-production" aria-labelledby="prod-h">
    <ProductionSlip days={15} title="Quince días en el taller" id="prod-h" />
  </section>

  <section class="home-box" aria-labelledby="box-h">
    <div class="box-grid wrap">
      <div class="box-copy">
        <h2 id="box-h">Se embala delante tuyo</h2>
        <p class="lede">Cuando terminás la compra, tu mueble entra en una caja de cartón doble, se cierra con cinta de papel y sale con tu nombre en la etiqueta.</p>
        <button class="btn ink" type="button" data-repack>Volver a embalar</button>
      </div>
      <BoxScene product={chair} id="home-box" />
    </div>
  </section>

  <section class="home-ship wrap" aria-labelledby="ship-h">
    <div class="section-head">
      <h2 id="ship-h">Sale de Tucumán, llega a tu provincia</h2>
      <p class="lede">Elegí el destino y mirá el camión hacer el viaje. El plazo se suma a los días de fabricación.</p>
    </div>
    <ShippingMap id="home-map" initial="cordoba" />
  </section>

  <section class="home-lines" aria-labelledby="lines-h">
    <div class="sheet-paper">
      <h2 id="lines-h">La carta del taller</h2>
      <p class="sheet-note">Doce líneas con nombre de pueblo tucumano. Acá van cuatro; el resto está en el catálogo.</p>
      {[...seatingLines, ...storageLines].map(({ line, items }) => (
        <div class="sheet-group">
          <h3>Línea {line}</h3>
          <ul>
            {items.map((p) => (
              <li>
                <a href={`/producto/${p.slug}`}>
                  <span class="sheet-name">{KINDS[p.kind].label}</span>
                  <span class="sheet-price num">{formatPrice(p.basePrice)}</span>
                  <span class="sheet-desc">{p.days} días · {p.woods.length} maderas{p.fabrics.length ? ` · ${p.fabrics.length} telas` : ''}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
      <a class="btn block" href="/catalogo">Ver las doce líneas</a>
    </div>
  </section>
</Layout>

<script>
  import { mount, prefersReducedMotion, isShowcase } from '../lib/page';
  import { loadScrollTrigger } from '../lib/gsap';

  mount<HTMLElement>('[data-hero]', (root) => {
    const stage = root.querySelector<HTMLElement>('[data-assembly]');
    const pieces = root.querySelector<HTMLElement>('[data-pieces]');
    if (!stage) return;
    const total = () => stage.querySelectorAll('g[style]').length;
    const setK = (k: number) => {
      stage.style.setProperty('--k', k.toFixed(3));
      const n = total();
      if (pieces) pieces.textContent = `${Math.round((1 - k) * n)} de ${n}`;
    };
    if (prefersReducedMotion()) {
      setK(0);
      return;
    }
    setK(1);
    let trigger: { kill: () => void } | null = null;
    void loadScrollTrigger().then(({ ScrollTrigger }) => {
      trigger = ScrollTrigger.create({
        trigger: root,
        start: 'top top',
        end: () => `+=${Math.round(window.innerHeight * (window.innerWidth < 960 ? 0.7 : 0.85))}`,
        scrub: isShowcase() ? true : 0.6,
        onUpdate: (self) => setK(1 - self.progress),
      });
    });
    return () => trigger?.kill();
  });

  mount<HTMLElement>('[data-hero]', () => {
    if (isShowcase() && !prefersReducedMotion()) void import('../scripts/showcase').then((m) => m.runShowcase());
  });

  mount<HTMLElement>('[data-repack]', (btn) => {
    const onClick = () => document.querySelector('[data-box="home-box"]')?.dispatchEvent(new CustomEvent('box:play'));
    btn.addEventListener('click', onClick);
    return () => btn.removeEventListener('click', onClick);
  });
</script>
