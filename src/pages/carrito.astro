---
import Layout from '../layouts/Layout.astro';
import BoxScene from '../components/BoxScene.astro';
import Icon from '../components/Icon.astro';
import { PRODUCTS } from '../data/catalog';
import { PROVINCES } from '../data/argentina';
---
<Layout title="Carrito" view="cart">
  <div class="cart wrap" data-cart-view>
    <header class="page-head">
      <h1>Tu caja</h1>
      <p class="lede" data-cart-lede>Revisá lo que elegiste. Cada mueble se fabrica a pedido y sale embalado desde Tucumán.</p>
    </header>

    <div class="cart-grid" data-cart-grid>
      <div class="cart-main">
        <ul class="cart-lines" data-lines aria-label="Productos en el carrito" aria-busy="true">
          {[0, 1].map(() => (
            <li class="cart-line is-skeleton" aria-hidden="true">
              <span class="cl-thumb skeleton"></span>
              <span class="cl-info"><span class="skeleton sk-line"></span><span class="skeleton sk-line short"></span></span>
            </li>
          ))}
        </ul>
        <div class="cart-empty" data-empty hidden>
          <h2>Tu caja está vacía</h2>
          <p>Elegí un mueble del catálogo, configuralo y aparece acá.</p>
          <a class="btn" href="/catalogo">Ir al catálogo <Icon name="arrow" size={20} /></a>
        </div>
      </div>

      <aside class="cart-side" aria-labelledby="summary-title" data-summary>
        <div class="cart-box">
          <BoxScene product={PRODUCTS[0]!} id="cart-box" autoplay={false} />
        </div>
        <h2 id="summary-title" class="side-title">Resumen</h2>
        <label class="field">
          <span class="label">Enviar a</span>
          <select data-province>
            {PROVINCES.map((p) => <option value={p.id}>{p.name}</option>)}
          </select>
        </label>
        <dl class="totals num">
          <div><dt>Subtotal</dt><dd data-subtotal>—</dd></div>
          <div><dt>Envío</dt><dd data-shipping>—</dd></div>
          <div class="grand"><dt>Total</dt><dd data-total>—</dd></div>
        </dl>
        <p class="side-note" data-eta></p>
        <a class="btn block" href="/checkout" data-checkout>Finalizar compra</a>
        <p class="side-note">Pago simulado con datos de prueba. No se cobra nada.</p>
      </aside>
    </div>
  </div>
</Layout>

<script>
  import { mount, escapeHtml, prefersReducedMotion } from '../lib/page';
  import { getProduct } from '../data/catalog';
  import { shippingQuote } from '../data/argentina';
  import { formatPrice } from '../lib/format';
  import { cartSubtotal, getState, subscribe, update, type CartLine } from '../lib/store';
  import { stockOf } from '../lib/sim';
  import { lineLabel, productionDaysFor, DEMO_CUSTOMER } from '../lib/orders';
  import { announce, thumbSvg, toast } from '../lib/ui';

  mount<HTMLElement>('[data-cart-view]', (root) => {
    const list = root.querySelector<HTMLUListElement>('[data-lines]');
    const empty = root.querySelector<HTMLElement>('[data-empty]');
    const summary = root.querySelector<HTMLElement>('[data-summary]');
    const province = root.querySelector<HTMLSelectElement>('[data-province]');
    const box = root.querySelector<HTMLElement>('[data-box]');
    if (!list || !empty || !summary || !province) return;
    province.value = getState().province;
    let lastFirst = '';

    function lineHtml(line: CartLine): string {
      const p = getProduct(line.productId);
      if (!p) return '';
      const left = stockOf(p.id);
      const stock = left === 0 ? 'Sin cupo este mes: entra en la próxima tanda' : left <= 3 ? `Quedan ${left} cupos` : '';
      return `<li class="cart-line" data-key="${escapeHtml(line.key)}">
        <a class="cl-thumb" href="/producto/${p.slug}?madera=${line.wood}${line.fabric ? `&tela=${line.fabric}` : ''}&medida=${line.size}" aria-label="${escapeHtml(p.name)}">${thumbSvg(p.id, { wood: line.wood, fabric: line.fabric, size: line.size })}</a>
        <div class="cl-info">
          <h3><a href="/producto/${p.slug}">${escapeHtml(p.name)}</a></h3>
          <p class="muted">${escapeHtml(lineLabel(line))}</p>
          ${stock ? `<p class="cl-stock">${stock}</p>` : ''}
          <div class="cl-row">
            <div class="stepper" role="group" aria-label="Cantidad de ${escapeHtml(p.name)}">
              <button type="button" data-qty="-1" aria-label="Quitar uno" ${line.qty <= 1 ? 'disabled' : ''}><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 12h12"/></svg></button>
              <output class="num" aria-live="polite">${line.qty}</output>
              <button type="button" data-qty="1" aria-label="Agregar uno" ${line.qty >= 9 ? 'disabled' : ''}><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 6v12M6 12h12"/></svg></button>
            </div>
            <button type="button" class="link-btn" data-remove>Quitar</button>
            <p class="cl-price num serif">${formatPrice(line.unitPrice * line.qty)}</p>
          </div>
        </div>
      </li>`;
    }

    function render(): void {
      if (!list || !empty || !summary || !province) return;
      const s = getState();
      list.removeAttribute('aria-busy');
      const hasItems = s.cart.length > 0;
      empty.hidden = hasItems;
      summary.hidden = !hasItems;
      root.classList.toggle('is-empty', !hasItems);
      list.innerHTML = s.cart.map(lineHtml).join('');
      const sub = cartSubtotal(s);
      const q = shippingQuote(province.value);
      const set = (sel: string, text: string) => {
        const node = root.querySelector(sel);
        if (node) node.textContent = text;
      };
      set('[data-subtotal]', formatPrice(sub));
      set('[data-shipping]', q.cost ? formatPrice(q.cost) : 'Sin cargo');
      set('[data-total]', formatPrice(sub + q.cost));
      set('[data-eta]', hasItems ? `Fabricación ${productionDaysFor(s.cart)} días + envío ${q.days} ${q.days === 1 ? 'día' : 'días'} a ${q.province.name}.` : '');
      const first = s.cart[0];
      const signature = first ? `${first.key}|${province.value}` : '';
      if (first && box && signature !== lastFirst) {
        const playNow = lastFirst !== '' || !prefersReducedMotion();
        lastFirst = signature;
        box.dispatchEvent(new CustomEvent('box:set', {
          detail: { productId: first.productId, size: first.size, wood: first.wood, fabric: first.fabric, to: DEMO_CUSTOMER.name, city: q.province.name, id: 'cart-box', play: playNow },
        }));
      }
    }

    list.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      const li = target.closest<HTMLElement>('[data-key]');
      if (!li) return;
      const key = li.dataset['key'];
      const qtyBtn = target.closest<HTMLButtonElement>('[data-qty]');
      if (qtyBtn) {
        const delta = Number(qtyBtn.dataset['qty']);
        update((s) => {
          const line = s.cart.find((l) => l.key === key);
          if (line) line.qty = Math.min(9, Math.max(1, line.qty + delta));
        });
        root.querySelector<HTMLButtonElement>(`[data-key="${CSS.escape(key ?? '')}"] [data-qty="${delta}"]`)?.focus();
        return;
      }
      if (target.closest('[data-remove]')) {
        const s = getState();
        const index = s.cart.findIndex((l) => l.key === key);
        const removed = s.cart[index];
        if (!removed) return;
        li.classList.add('leaving');
        window.setTimeout(() => {
          update((d) => {
            d.cart = d.cart.filter((l) => l.key !== key);
          });
          const name = getProduct(removed.productId)?.name ?? 'Producto';
          announce(`${name} quitado del carrito.`);
          toast({
            title: `${name} quitado`,
            body: lineLabel(removed),
            action: { label: 'Deshacer', run: () => update((d) => { d.cart.splice(Math.min(index, d.cart.length), 0, removed); }) },
          });
        }, prefersReducedMotion() ? 0 : 260);
      }
    });

    province.addEventListener('change', () => {
      update((s) => {
        s.province = province.value;
      });
    });

    // brief skeleton, then real content
    const t = window.setTimeout(render, 280);
    const signature = () => {
      const s = getState();
      return JSON.stringify([s.cart, s.province, s.cart.map((l) => stockOf(l.productId, s) <= 3 ? stockOf(l.productId, s) : 9)]);
    };
    let lastSig = signature();
    const unsub = subscribe(() => {
      const sig = signature();
      if (sig !== lastSig) {
        lastSig = sig;
        render();
      }
    });
    return () => {
      window.clearTimeout(t);
      unsub();
    };
  });
</script>
