---
import Layout from "../../layouts/Layout.astro";
import CatalogBrowser from "../../components/islands/CatalogBrowser.tsx";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { getCollection } from "astro:content";
import { CATEGORIAS } from "../../lib/site.ts";

const productos = await getCollection("productos");

// Filtrado por query param `cat` en SSR (mantenido de la versión previa)
const url = new URL(Astro.request.url);
const catParam = url.searchParams.get("cat") ?? "todas";
const categoriaActiva = CATEGORIAS.find((c) => c.id === catParam)?.id ?? null;

const categoriaLabel = (id: string) => {
  const found = CATEGORIAS.find((c) => c.id === id);
  return found?.nombre ?? id;
};

const productosSerializables = productos.map((p) => ({
  slug: p.id,
  nombre: p.data.nombre,
  categoria: p.data.categoria,
  categoriaId: p.data.categoria,
  precio: p.data.precio,
  descripcion_corta: p.data.descripcion_corta,
  imagen: p.data.imagen,
  imagen_alt: p.data.imagen_alt,
  rating_promedio: p.data.rating_promedio,
  rating_cantidad: p.data.rating_cantidad ?? 0,
  ventas_simuladas: p.data.ventas_simuladas ?? 0,
  fecha_agregado: p.data.fecha_agregado,
  aromas: p.data.aromas,
  ingredientes_tags: p.data.ingredientes_tags,
  materiales: p.data.materiales,
  stock: p.data.stock,
  stock_bajo: p.data.stock_bajo ?? 3,
  es_bundle: p.data.es_bundle ?? false,
}));

const crumbs = categoriaActiva
  ? [
      { href: "/", label: "Inicio" },
      { href: "/productos", label: "Catálogo" },
      { href: `/categoria/${categoriaActiva}`, label: categoriaLabel(categoriaActiva) },
    ]
  : [
      { href: "/", label: "Inicio" },
      { href: "/productos", label: "Catálogo", current: true },
    ];
---

<Layout
  title="Catálogo · Verdeo Tienda"
  description="Catálogo completo de velas de soja, difusores, jabones artesanales y textiles de algodón orgánico."
>
  <Breadcrumbs crumbs={crumbs} />

  <section class="mx-auto max-w-[1400px] px-5 md:px-10 pt-8 pb-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-end">
      <div class="lg:col-span-7">
        <div class="eyebrow mb-3">Catálogo</div>
        <h1 class="display text-[44px] md:text-[80px] leading-[0.95]">
          {categoriaActiva
            ? categoriaLabel(categoriaActiva)
            : "Todos los productos"}
        </h1>
        <p class="mt-4 text-muted max-w-[52ch]">
          {categoriaActiva
            ? (CATEGORIAS.find((c) => c.id === categoriaActiva)?.introLargo ?? "")
            : "Velas, difusores, jabones y textiles. Elaborados a mano con ingredientes nobles."}
        </p>
      </div>
      <div class="lg:col-span-5 text-sm text-muted lg:text-right">
        {categoriaActiva && (
          <a
            href="/productos"
            class="inline-flex items-center hover:text-forest transition-colors"
          >
            Ver todas las categorías
            <svg viewBox="0 0 24 24" class="w-3.5 h-3.5 ml-1" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M5 12h14M13 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </a>
        )}
      </div>
    </div>
  </section>

  <section
    class="mx-auto max-w-[1400px] px-5 md:px-10 pb-20 md:pb-32"
    aria-label="Listado de productos"
  >
    <CatalogBrowser
      client:only="preact"
      productos={productosSerializables}
      categoriaInicial={categoriaActiva}
    />
  </section>
</Layout>
