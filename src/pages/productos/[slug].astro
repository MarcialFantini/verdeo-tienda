---
export const prerender = true;

import Layout from "../../layouts/Layout.astro";
import ProductCard from "../../components/ProductCard.astro";
import AddToCart from "../../components/islands/AddToCart.tsx";
import { getCollection, type CollectionEntry } from "astro:content";
import { CATEGORIAS, formatPrecio } from "../../lib/site.ts";

export async function getStaticPaths() {
  const productos = await getCollection("productos");
  return productos.map((producto) => ({
    params: { slug: producto.id },
    props: { producto },
  }));
}

interface Props {
  producto: CollectionEntry<"productos">;
}

const { producto } = Astro.props;
const {
  nombre,
  categoria,
  precio,
  descripcion_corta,
  descripcion_larga,
  ingredientes,
  dimensiones,
  peso,
  tiempo_quema,
  aroma,
  imagen,
  imagen_alt,
  stock,
  sku,
} = producto.data;

const fallbackImg = `https://picsum.photos/seed/${producto.id}/1200/1500`;
const categoriaLabel = CATEGORIAS.find((c) => c.id === categoria)?.nombre ?? categoria;

// Productos relacionados (misma categoría, excluir el actual)
const todos = await getCollection("productos");
const relacionados = todos
  .filter((p) => p.data.categoria === categoria && p.id !== producto.id)
  .slice(0, 4);
---

<Layout
  title={`${nombre} · Verdeo Tienda`}
  description={descripcion_corta}
>
  <!-- Migas -->
  <nav
    class="mx-auto max-w-[1400px] px-5 md:px-10 pt-6 md:pt-10 text-xs text-muted"
    aria-label="Migas de pan"
  >
    <ol class="flex items-center gap-2 flex-wrap">
      <li><a href="/" class="hover:text-forest transition-colors">Inicio</a></li>
      <li aria-hidden="true">/</li>
      <li><a href="/productos" class="hover:text-forest transition-colors">Catálogo</a></li>
      <li aria-hidden="true">/</li>
      <li>
        <a href={`/productos?cat=${categoria}`} class="hover:text-forest transition-colors">
          {categoriaLabel}
        </a>
      </li>
      <li aria-hidden="true">/</li>
      <li class="text-ink truncate max-w-[40ch]">{nombre}</li>
    </ol>
  </nav>

  <!-- FICHA -->
  <section class="mx-auto max-w-[1400px] px-5 md:px-10 pt-8 pb-16 md:pb-24">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16">
      <!-- Imagen -->
      <div class="lg:col-span-7">
        <div class="bezel-outer">
          <div class="bezel-inner overflow-hidden">
            <div class="aspect-[4/5] bg-linen relative">
              <img
                src={imagen}
                alt={imagen_alt}
                class="w-full h-full object-cover"
                loading="eager"
                fetchpriority="high"
                onerror={`this.onerror=null;this.src='${fallbackImg}';`}
              />
            </div>
          </div>
        </div>
      </div>

      <!-- Datos -->
      <div class="lg:col-span-5 flex flex-col">
        <div class="flex items-center gap-3 mb-3">
          <span class="eyebrow">{categoriaLabel}</span>
          <span class="text-muted text-xs">·</span>
          <span class="text-xs text-muted">{sku}</span>
        </div>
        <h1 class="display text-[36px] md:text-[56px] leading-[0.98]">
          {nombre}
        </h1>
        <p class="mt-4 text-lg text-muted leading-relaxed max-w-[44ch]">
          {descripcion_corta}
        </p>

        <div class="mt-6 flex items-baseline gap-3">
          <div class="text-3xl display tabular-nums">{formatPrecio(precio)}</div>
          <div class="text-xs text-muted">
            {stock > 0 ? `${stock} en stock` : "Sin stock"}
          </div>
        </div>

        <hr class="hairline my-8" />

        <!-- Add to cart island -->
        <AddToCart
          client:load
          slug={producto.id}
          nombre={nombre}
          precio={precio}
          imagen={imagen}
          stock={stock}
        />

        <hr class="hairline my-8" />

        <!-- Detalles expandibles -->
        <details class="group border-b border-[var(--color-hairline)] py-4" open>
          <summary class="flex items-center justify-between cursor-pointer list-none">
            <span class="font-medium">Descripción</span>
            <svg viewBox="0 0 24 24" class="w-4 h-4 transition-transform duration-300 group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </summary>
          <p class="mt-3 text-sm text-muted leading-relaxed">
            {descripcion_larga}
          </p>
        </details>

        {ingredientes && (
          <details class="group border-b border-[var(--color-hairline)] py-4">
            <summary class="flex items-center justify-between cursor-pointer list-none">
              <span class="font-medium">Ingredientes</span>
              <svg viewBox="0 0 24 24" class="w-4 h-4 transition-transform duration-300 group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </summary>
            <p class="mt-3 text-sm text-muted leading-relaxed">
              {ingredientes}
            </p>
          </details>
        )}

        <details class="group border-b border-[var(--color-hairline)] py-4">
          <summary class="flex items-center justify-between cursor-pointer list-none">
            <span class="font-medium">Especificaciones</span>
            <svg viewBox="0 0 24 24" class="w-4 h-4 transition-transform duration-300 group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </summary>
          <dl class="mt-3 grid grid-cols-2 gap-3 text-sm">
            {dimensiones && (<>
              <dt class="text-muted">Dimensiones</dt>
              <dd>{dimensiones}</dd>
            </>)}
            {peso && (<>
              <dt class="text-muted">{categoria === "difusores" ? "Contenido" : "Peso"}</dt>
              <dd>{peso}</dd>
            </>)}
            {tiempo_quema && (<>
              <dt class="text-muted">Tiempo de quema</dt>
              <dd>{tiempo_quema}</dd>
            </>)}
            {aroma && (<>
              <dt class="text-muted">Aroma</dt>
              <dd>{aroma}</dd>
            </>)}
            <dt class="text-muted">SKU</dt>
            <dd class="font-mono text-xs">{sku}</dd>
          </dl>
        </details>
      </div>
    </div>
  </section>

  <!-- RELACIONADOS -->
  {relacionados.length > 0 && (
    <section class="mx-auto max-w-[1400px] px-5 md:px-10 py-16 md:py-24 border-t border-[var(--color-hairline)]">
      <div class="flex items-end justify-between mb-10">
        <h2 class="display text-[28px] md:text-[40px] leading-[1]">
          También te puede interesar
        </h2>
        <a
          href={`/productos?cat=${categoria}`}
          class="hidden md:inline-flex text-sm hover:text-forest transition-colors"
        >
          Ver más de {categoriaLabel.toLowerCase()} →
        </a>
      </div>
      <ul class="grid grid-cols-2 lg:grid-cols-4 gap-x-4 md:gap-x-7 gap-y-10">
        {relacionados.map((p) => (
          <li>
            <ProductCard producto={p} />
          </li>
        ))}
      </ul>
    </section>
  )}
</Layout>
