---
export const prerender = true;

import Layout from "../../layouts/Layout.astro";
import ProductCard from "../../components/ProductCard.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import AddToCart from "../../components/islands/AddToCart.tsx";
import VariantsPicker from "../../components/islands/VariantsPicker.tsx";
import Reviews from "../../components/islands/Reviews.tsx";
import WishlistButton from "../../components/islands/WishlistButton.tsx";
import StockBadge from "../../components/islands/StockBadge.tsx";
import StickyAddToCart from "../../components/islands/StickyAddToCart.tsx";
import RecentlyViewed from "../../components/islands/RecentlyViewed.tsx";
import { getCollection, type CollectionEntry } from "astro:content";
import { CATEGORIAS, formatPrecio, labelCategoria } from "../../lib/site.ts";
import { getReviewsSeed } from "../../lib/reviews.ts";

export async function getStaticPaths() {
  const productos = await getCollection("productos");
  return productos.map((producto) => ({
    params: { slug: producto.id },
    props: { producto },
  }));
}

interface Props {
  producto: CollectionEntry<"productos">;
}

const { producto } = Astro.props;
const data = producto.data;
const {
  nombre,
  categoria,
  precio,
  descripcion_corta,
  descripcion_larga,
  ingredientes,
  dimensiones,
  peso,
  tiempo_quema,
  aroma,
  imagen,
  imagen_alt,
  stock,
  stock_bajo,
  sku,
  variantes,
  es_bundle,
  bundle_slugs,
  rating_promedio,
  rating_cantidad,
} = data;

const fallbackImg = `https://picsum.photos/seed/${producto.id}/1200/1500`;
const categoriaLabel = CATEGORIAS.find((c) => c.id === categoria)?.nombre ?? categoria;
const tieneVariantes = !!variantes && variantes.length > 0;
const rating = rating_promedio ?? 0;
const ratingCount = rating_cantidad ?? 0;

const MICROCOPY_MARCA = [
  "Hecho a mano",
  "Empaque compostable",
  "Origen: Argentina",
];
const MICROCOPY_POR_CATEGORIA: Record<string, string> = {
  velas: "Cera de soja",
  difusores: "Varillas de ratán",
  jabones: "Saponificación en frío",
  textiles: "Algodón orgánico",
  bundles: "Selección curada",
};
const microcopyTags = [
  ...MICROCOPY_MARCA,
  MICROCOPY_POR_CATEGORIA[categoria] ?? "Ingredientes nobles",
];

// Galería (misma lógica que antes).
const galeria: Array<{ src: string; alt: string; thumb: string }> = [
  {
    src: imagen,
    alt: imagen_alt,
    thumb: `${imagen.split("?")[0]}?w=240&h=300&fit=crop&q=70&auto=format`,
  },
  {
    src: `https://picsum.photos/seed/${producto.id}-ambiente/1200/1500`,
    alt: `${nombre} en ambiente`,
    thumb: `https://picsum.photos/seed/${producto.id}-ambiente/240/300`,
  },
  {
    src: `https://picsum.photos/seed/${producto.id}-detalle/1200/1500`,
    alt: `Detalle de ${nombre.toLowerCase()}`,
    thumb: `https://picsum.photos/seed/${producto.id}-detalle/240/300`,
  },
];

// Relacionados: misma categoría + cross-sell de otras categorías.
const todos = await getCollection("productos");
const relacionados = todos
  .filter((p) => p.data.categoria === categoria && p.id !== producto.id)
  .slice(0, 4);

const crossSell = todos
  .filter((p) => p.data.categoria !== categoria && p.id !== producto.id)
  .slice(0, 4);

// Reseñas seed.
const reviewsSeed = getReviewsSeed(producto.id);

// Productos para RecentlyViewed.
const productosParaRecent = todos.map((p) => ({
  slug: p.id,
  nombre: p.data.nombre,
  imagen: p.data.imagen,
  imagen_alt: p.data.imagen_alt,
  precio: p.data.precio,
  categoria: p.data.categoria,
  categoriaLabel: labelCategoria(p.data.categoria),
}));

// Componentes del bundle.
const bundleProductos = es_bundle && bundle_slugs
  ? bundle_slugs
      .map((s) => todos.find((p) => p.id === s))
      .filter((p): p is CollectionEntry<"productos"> => Boolean(p))
  : [];

const crumbs = [
  { href: "/", label: "Inicio" },
  { href: "/productos", label: "Catálogo" },
  { href: `/categoria/${categoria}`, label: categoriaLabel },
  { href: `/productos/${producto.id}`, label: nombre, current: true },
];
---

<Layout
  title={`${nombre} · Verdeo Tienda`}
  description={descripcion_corta}
>
  <Breadcrumbs crumbs={crumbs} />

  <section class="mx-auto max-w-[1400px] px-5 md:px-10 pt-8 pb-16 md:pb-24">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16">
      <!-- Galería -->
      <div class="lg:col-span-7">
        <div class="bezel-outer">
          <div class="bezel-inner overflow-hidden">
            <div class="aspect-[4/5] bg-linen relative">
              {galeria.map((g, i) => (
                <img
                  src={g.src}
                  alt={g.alt}
                  class={`w-full h-full object-cover absolute inset-0 transition-opacity duration-500 ${i === 0 ? "opacity-100" : "opacity-0"}`}
                  data-galeria-img={i}
                  loading={i === 0 ? "eager" : "lazy"}
                  fetchpriority={i === 0 ? "high" : "auto"}
                  onerror={`this.onerror=null;this.src='${fallbackImg}';`}
                />
              ))}
            </div>
          </div>
        </div>

        {galeria.length > 1 && (
          <ul
            class="mt-4 grid grid-cols-3 gap-3 md:gap-4"
            aria-label="Vistas alternativas del producto"
            data-galeria-thumbs
            data-target={producto.id}
          >
            {galeria.map((g, i) => (
              <li>
                <button
                  type="button"
                  class={`bezel-outer block w-full transition-all duration-300 ${i === 0 ? "ring-1 ring-[var(--color-amber)]" : ""}`}
                  data-galeria-thumb={i}
                  aria-label={`Ver vista ${i + 1} de ${galeria.length}`}
                  aria-pressed={i === 0 ? "true" : "false"}
                >
                  <span class="bezel-inner block overflow-hidden">
                    <span class="block aspect-[4/5] bg-linen">
                      <img
                        src={g.thumb}
                        alt=""
                        loading="lazy"
                        decoding="async"
                        class="w-full h-full object-cover"
                        onerror={`this.onerror=null;this.src='https://picsum.photos/seed/${producto.id}-thumb${i}/240/300';`}
                      />
                    </span>
                  </span>
                </button>
              </li>
            ))}
          </ul>
        )}
      </div>

      <!-- Datos -->
      <div class="lg:col-span-5 flex flex-col">
        <div class="flex items-center gap-3 mb-3 flex-wrap">
          <span class="eyebrow">{categoriaLabel}</span>
          <span class="text-muted text-xs" aria-hidden="true">·</span>
          <span class="text-xs text-muted font-mono">{sku}</span>
          {rating > 0 && ratingCount > 0 && (
            <>
              <span class="text-muted text-xs" aria-hidden="true">·</span>
              <span
                class="inline-flex items-center gap-1 text-xs text-ink"
                aria-label={`Rating ${rating.toFixed(1)} sobre 5 con ${ratingCount} reseñas`}
              >
                <svg viewBox="0 0 24 24" class="w-3.5 h-3.5 text-amber" fill="currentColor" aria-hidden="true">
                  <path d="M12 2.5l2.95 6 6.6.96-4.78 4.66 1.13 6.58L12 17.6l-5.9 3.1 1.13-6.58L2.45 9.46l6.6-.96L12 2.5z" />
                </svg>
                <span class="tabular-nums">{rating.toFixed(1)}</span>
                <span class="text-muted">({ratingCount})</span>
              </span>
            </>
          )}
        </div>

        <div class="flex items-start justify-between gap-4">
          <h1 class="display text-[36px] md:text-[56px] leading-[0.98] flex-1">
            {nombre}
          </h1>
          <WishlistButton client:load slug={producto.id} nombre={nombre} size="md" />
        </div>

        <ul
          class="mt-5 flex flex-wrap gap-2"
          aria-label="Características del producto"
        >
          {microcopyTags.map((tag) => (
            <li>
              <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-cream border border-[var(--color-hairline)] text-xs text-ink/80">
                <svg
                  viewBox="0 0 24 24"
                  class="w-3.5 h-3.5 text-forest"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  aria-hidden="true"
                >
                  <path d="M5 12l5 5 9-11" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
                {tag}
              </span>
            </li>
          ))}
        </ul>

        <p class="mt-5 text-lg text-muted leading-relaxed max-w-[44ch]">
          {descripcion_corta}
        </p>

        <div class="mt-6 flex items-baseline gap-3 flex-wrap">
          <div class="text-3xl display tabular-nums">{formatPrecio(precio)}</div>
          <StockBadge
            stock={tieneVariantes ? (variantes![0]?.stock ?? stock) : stock}
            stockBajo={stock_bajo ?? 3}
            variantesCount={variantes?.length}
          />
        </div>

        <hr class="hairline my-8" />

        <!-- Add to cart (variante si aplica) -->
        <div class="add-to-cart-sentinel">
          {tieneVariantes ? (
            <VariantsPicker
              client:load
              slug={producto.id}
              nombre={nombre}
              precioBase={precio}
              imagen={imagen}
              imagenAlt={imagen_alt}
              variantes={variantes!}
              stockBase={stock}
              stockBajoBase={stock_bajo ?? 3}
            />
          ) : (
            <AddToCart
              client:load
              slug={producto.id}
              nombre={nombre}
              precio={precio}
              imagen={imagen}
              stock={stock}
            />
          )}
        </div>

        <hr class="hairline my-8" />

        <!-- Si es bundle, mostramos qué incluye -->
        {es_bundle && bundleProductos.length > 0 && (
          <details class="group border-b border-[var(--color-hairline)] py-4" open>
            <summary class="flex items-center justify-between cursor-pointer list-none">
              <span class="font-medium">¿Qué incluye este kit?</span>
              <svg viewBox="0 0 24 24" class="w-4 h-4 transition-transform duration-300 group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </summary>
            <ul class="mt-3 flex flex-col gap-2 text-sm">
              {bundleProductos.map((p) => (
                <li class="flex items-center gap-3 text-muted">
                  <img src={p.data.imagen} alt="" class="w-12 h-14 rounded-md object-cover bg-linen shrink-0" loading="lazy" />
                  <a href={`/productos/${p.id}`} class="hover:text-forest transition-colors">{p.data.nombre}</a>
                </li>
              ))}
            </ul>
          </details>
        )}

        <details class="group border-b border-[var(--color-hairline)] py-4" open>
          <summary class="flex items-center justify-between cursor-pointer list-none">
            <span class="font-medium">Descripción</span>
            <svg viewBox="0 0 24 24" class="w-4 h-4 transition-transform duration-300 group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </summary>
          <p class="mt-3 text-sm text-muted leading-relaxed">
            {descripcion_larga}
          </p>
        </details>

        {ingredientes && (
          <details class="group border-b border-[var(--color-hairline)] py-4">
            <summary class="flex items-center justify-between cursor-pointer list-none">
              <span class="font-medium">Ingredientes</span>
              <svg viewBox="0 0 24 24" class="w-4 h-4 transition-transform duration-300 group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </summary>
            <p class="mt-3 text-sm text-muted leading-relaxed">
              {ingredientes}
            </p>
          </details>
        )}

        <details class="group border-b border-[var(--color-hairline)] py-4">
          <summary class="flex items-center justify-between cursor-pointer list-none">
            <span class="font-medium">Especificaciones</span>
            <svg viewBox="0 0 24 24" class="w-4 h-4 transition-transform duration-300 group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </summary>
          <dl class="mt-3 grid grid-cols-2 gap-3 text-sm">
            {dimensiones && (<><dt class="text-muted">Dimensiones</dt><dd>{dimensiones}</dd></>)}
            {peso && (<><dt class="text-muted">{categoria === "difusores" ? "Contenido" : "Peso"}</dt><dd>{peso}</dd></>)}
            {tiempo_quema && (<><dt class="text-muted">Tiempo de quema</dt><dd>{tiempo_quema}</dd></>)}
            {aroma && (<><dt class="text-muted">Aroma</dt><dd>{aroma}</dd></>)}
            <dt class="text-muted">SKU</dt><dd class="font-mono text-xs">{sku}</dd>
          </dl>
        </details>
      </div>
    </div>
  </section>

  <Reviews
    client:visible
    slug={producto.id}
    nombreProducto={nombre}
    seed={reviewsSeed}
  />

  {relacionados.length > 0 && (
    <section class="mx-auto max-w-[1400px] px-5 md:px-10 py-16 md:py-24 border-t border-[var(--color-hairline)]">
      <div class="flex items-end justify-between mb-10">
        <h2 class="display text-[28px] md:text-[40px] leading-[1]">
          También te puede interesar
        </h2>
        <a
          href={`/categoria/${categoria}`}
          class="hidden md:inline-flex text-sm hover:text-forest transition-colors"
        >
          Ver más de {categoriaLabel.toLowerCase()} →
        </a>
      </div>
      <ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-4 md:gap-x-7 gap-y-10">
        {relacionados.map((p) => (
          <li>
            <ProductCard producto={p} />
          </li>
        ))}
      </ul>
    </section>
  )}

  {crossSell.length > 0 && (
    <section class="mx-auto max-w-[1400px] px-5 md:px-10 pb-16 md:pb-24">
      <div class="flex items-end justify-between mb-8">
        <h2 class="display text-[24px] md:text-[32px] leading-[1]">
          Para sumar a tu pedido
        </h2>
      </div>
      <ul class="grid grid-cols-2 md:grid-cols-4 gap-x-4 md:gap-x-7 gap-y-8">
        {crossSell.map((p) => (
          <li>
            <ProductCard producto={p} />
          </li>
        ))}
      </ul>
    </section>
  )}

  <RecentlyViewed
    client:visible
    productos={productosParaRecent}
    excludeSlug={producto.id}
    max={4}
  />

  <StickyAddToCart
    client:load
    slug={producto.id}
    nombre={nombre}
    precio={precio}
    imagen={imagen}
    stock={stock}
  />

  <!-- JSON-LD: Product schema para SEO/Google Shopping -->
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Product",
      name: nombre,
      description: descripcion_larga,
      sku: sku,
      brand: { "@type": "Brand", name: "Verdeo" },
      category: categoriaLabel,
      image: imagen,
      offers: {
        "@type": "Offer",
        price: precio,
        priceCurrency: "ARS",
        availability:
          stock > 0 ? "https://schema.org/InStock" : "https://schema.org/OutOfStock",
        url: Astro.url.href,
      },
      ...(rating_promedio && rating_cantidad
        ? {
            aggregateRating: {
              "@type": "AggregateRating",
              ratingValue: rating_promedio,
              reviewCount: rating_cantidad,
              bestRating: 5,
              worstRating: 1,
            },
          }
        : {}),
    })}
  />
</Layout>

<script is:inline>
  (function () {
    if (typeof window === "undefined") return;
    const groups = document.querySelectorAll("[data-galeria-thumbs]");
    groups.forEach((ul) => {
      const buttons = ul.querySelectorAll("[data-galeria-thumb]");
      buttons.forEach((btn) => {
        btn.addEventListener("click", () => {
          const idx = Number(btn.getAttribute("data-galeria-thumb"));
          const section = btn.closest("section");
          if (!section) return;
          const imgs = section.querySelectorAll("[data-galeria-img]");
          imgs.forEach((img, i) => {
            img.classList.toggle("opacity-100", i === idx);
            img.classList.toggle("opacity-0", i !== idx);
          });
          buttons.forEach((b, i) => {
            const wrap = b.closest("button");
            if (!wrap) return;
            wrap.classList.toggle("ring-1", i === idx);
            wrap.classList.toggle("ring-[var(--color-amber)]", i === idx);
            b.setAttribute("aria-pressed", i === idx ? "true" : "false");
          });
        });
      });
    });
  })();
</script>
