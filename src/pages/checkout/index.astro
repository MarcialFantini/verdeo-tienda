---
export const prerender = true;

import Layout from "../../layouts/Layout.astro";
import CheckoutForm from "../../components/islands/CheckoutForm.tsx";
---

<Layout
  title="Checkout · Verdeo Tienda"
  description="Finalizá tu pedido en Verdeo Tienda."
>
  <section class="mx-auto max-w-[1400px] px-5 md:px-10 pt-10 md:pt-16 pb-16 md:pb-24">
    <div class="mb-10 md:mb-14">
      <div class="eyebrow mb-3">Finalizar compra</div>
      <h1 class="display text-[44px] md:text-[72px] leading-[0.95]">
        Checkout
      </h1>
      <p class="mt-3 text-muted max-w-[52ch]">
        Completá tus datos y elegí cómo querés pagar. Esta es una tienda demo: no
        procesamos pagos reales ni despachamos pedidos.
      </p>
    </div>

    <CheckoutForm client:only="preact" />
  </section>
</Layout>
